# Public origin of the deployed connector. Must be the Cloud Run (run.app) URL of
# the gen2 function, with no path — the OAuth metadata documents live at its root.
# Set a placeholder for the first deploy, then update it with the real URL.
ISSUER_URL=https://connector-000000000000.europe-west8.run.app

# Firebase web config — the same public values as NEXT_PUBLIC_FIREBASE_* in the
# app. Used by the sign-in page so the password only ever travels to Google.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
