{
  "name": "cadence-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only remote MCP server for Cadence (Claude/ChatGPT/Gemini connector)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "esbuild src/dev-server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/dev-server.js --external:firebase-admin --external:firebase-functions && node lib/dev-server.js",
    "seed": "esbuild scripts/seed-emulator.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/seed-emulator.js --external:firebase-admin && node lib/seed-emulator.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "jose": "^6.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
